# Point the dashboard at the real FastAPI backend.
# Leave VITE_USE_MOCK unset (or "true") to run entirely on seeded mock data.

# Split deployment (backend on Render, frontend on Vercel — DEPLOY.md Option A):
# a full URL, since the two are on different domains.
VITE_API_BASE_URL=http://localhost:8000

# Combined deployment (everything on one Vercel project — DEPLOY.md Option B):
# leave this EMPTY, not omitted. An unset variable falls back to
# http://localhost:8000 above; an explicit empty string makes every request a
# relative /api/v1/... path, which resolves against whatever origin served the
# page — exactly what the vercel.json rewrite expects, and how CORS is avoided
# entirely in that setup.
#   VITE_API_BASE_URL=

VITE_USE_MOCK=false
